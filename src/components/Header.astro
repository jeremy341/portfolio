---
import { langs, otherPath, ui, url, type Lang } from "../lib/i18n";
import { navFor, site } from "../lib/site";

interface Props {
  home?: boolean;
  lang: Lang;
}

const { home = false, lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header frame">
  <a class="brand" href={url(lang, "/")} data-home={home ? "" : undefined} tabindex={home ? -1 : undefined} aria-hidden={home ? "true" : undefined}>{site.name}</a>
  <nav class="site-nav" aria-label={t.mainNav}>
    <span class="nav-cur" aria-hidden="true"></span>
    {navFor(lang).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    <button type="button" class="find-btn" data-find><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5 14 14" /></svg><span class="btn-text">{t.search}</span> <kbd>/</kbd></button>
    <div class="lang" role="group" aria-label={t.language} data-on={lang}>
      <span class="lang-cur" aria-hidden="true"></span>
      {langs.map((code) => (
        <a
          href={/404(\.html|\/)$/.test(path) ? url(code, "/") : otherPath(path, code)}
          lang={code}
          hreflang={code}
          title={ui[code].languageName[code]}
          aria-current={code === lang ? "true" : undefined}
        >{code.toUpperCase()}</a>
      ))}
    </div>
    <button type="button" class="theme-btn" data-theme-switch><svg class="ico ico-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.3 3.3l1.3 1.3M11.4 11.4l1.3 1.3M3.3 12.7l1.3-1.3M11.4 4.6l1.3-1.3" /></svg><svg class="ico ico-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" /></svg><span class="btn-text">{t.themeLight}</span></button>
  </nav>
</header>

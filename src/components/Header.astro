---
import { langs, otherPath, ui, url, type Lang } from "../lib/i18n";
import { navFor, site } from "../lib/site";

interface Props {
  home?: boolean;
  lang: Lang;
}

const { home = false, lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
const switchUrl = (code: Lang) => /404(\.html|\/)$/.test(path) ? url(code, "/") : otherPath(path, code);
---

<header class="site-header frame">
  <a class="brand" href={url(lang, "/")} data-home={home ? "" : undefined} aria-label={site.name}>
    <span class="brand-full">{site.name}</span>
    <span class="brand-mobile" aria-hidden="true">Jeremy.</span>
  </a>

  <!-- Desktop retains the original editor-like navigation. -->
  <nav class="site-nav" aria-label={t.mainNav}>
    <span class="nav-cur" aria-hidden="true"></span>
    {navFor(lang).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    <button type="button" class="find-btn" data-find>{t.search} <kbd>/</kbd></button>
    <div class="lang" role="group" aria-label={t.language} data-on={lang}>
      <span class="lang-cur" aria-hidden="true"></span>
      {langs.map((code) => (
        <a href={switchUrl(code)} lang={code} hreflang={code} title={ui[code].languageName[code]} aria-current={code === lang ? "true" : undefined}>{code.toUpperCase()}</a>
      ))}
    </div>
    <button type="button" class="theme-btn" data-theme-switch aria-label={t.themeLight}>
      <span data-theme-label>{t.themeLight}</span>
      <svg class="theme-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <g class="theme-sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></g>
        <path class="theme-moon" d="M20.5 14a9 9 0 0 1-10.5-10.5A9 9 0 1 0 20.5 14Z" />
      </svg>
    </button>
  </nav>

  <!-- On touch screens: two clear actions, not a wrapping row of nine controls. -->
  <div class="mobile-controls">
    <button type="button" class="mobile-find" data-find aria-label={t.search} title={t.search}>
      <span class="search-glyph" aria-hidden="true"></span>
    </button>
    <details class="mobile-nav">
      <summary class="mobile-toggle" aria-label={t.menu}>
        <span class="menu-glyph" aria-hidden="true"></span>
      </summary>
      <nav class="mobile-panel" aria-label={t.mainNav}>
        {navFor(lang).map((item, index) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            <span>{item.label}</span><span class="mobile-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          </a>
        ))}
        <div class="mobile-settings">
          <div class="lang" role="group" aria-label={t.language} data-on={lang}>
            <span class="lang-cur" aria-hidden="true"></span>
            {langs.map((code) => (
              <a href={switchUrl(code)} lang={code} hreflang={code} title={ui[code].languageName[code]} aria-current={code === lang ? "true" : undefined}>{code.toUpperCase()}</a>
            ))}
          </div>
          <button type="button" class="theme-btn" data-theme-switch>{t.themeLight}</button>
        </div>
      </nav>
    </details>
  </div>
</header>

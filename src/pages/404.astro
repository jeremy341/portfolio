---
import Base from "../layouts/Base.astro";
import { ui } from "../lib/i18n";
import { navFor } from "../lib/site";
import "../styles/notfound.css";

// One 404 page serves every missing address. English is the default; an address under /de/ is
// answered in German. The server renders English, and a tiny inline script swaps in German
// before the page settles, so the page works without JavaScript too.
const en = ui.en;
const de = ui.de;
const strings = {
  en: { title: en.notFoundTitle, text: en.notFoundText, back: en.notFoundBack, home: "/", href: "/work/", hint: en.notFoundHint, quest: en.notFoundQuest, found: en.notFoundFound, error: en.notFoundError, offline: en.notFoundOffline, nav: navFor("en"), mainNav: en.mainNav, language: en.language, skip: en.skip, menu: en.menu, search: en.search },
  de: { title: de.notFoundTitle, text: de.notFoundText, back: de.notFoundBack, home: "/de/", href: "/de/work/", hint: de.notFoundHint, quest: de.notFoundQuest, found: de.notFoundFound, error: de.notFoundError, offline: de.notFoundOffline, nav: navFor("de"), mainNav: de.mainNav, language: de.language, skip: de.skip, menu: de.menu, search: de.search },
};
---

<Base title={en.notFoundTitle} description={en.notFoundDescription} noindex lang="en">
  <section class="notfound-pond" aria-labelledby="nf-title">
    <canvas class="koi-pond" aria-hidden="true"></canvas>
    <div class="notfound-inner">
      <div class="notfound-copy">
        <p class="notfound-path" id="nf-path" aria-hidden="true">~/jeremy-darko/404.md <span class="notfound-error" id="nf-error">no such file</span></p>
        <p class="notfound-code" aria-hidden="true">404</p>
        <h1 class="page-title" id="nf-title">{en.notFoundTitle}</h1>
        <p class="page-lead" id="nf-offline" hidden>{en.notFoundOffline}</p>
        <p class="page-lead" id="nf-text">{en.notFoundText} <a href="/work/" id="nf-back">{en.notFoundBack}</a>.</p>
        <p class="notfound-quest" id="nf-quest" aria-live="polite" hidden>{en.notFoundQuest} · 0/3</p>
      </div>
      <p class="notfound-hint" id="nf-hint-wrap" hidden><span id="nf-hint">{en.notFoundHint}</span></p>
    </div>
  </section>

  <script type="application/json" id="nf-strings" set:html={JSON.stringify(strings)}></script>
  <script is:inline>
    (function () {
      try {
        var german = /^\/de(?:\/|$)/.test(location.pathname);
        var t = JSON.parse(document.getElementById("nf-strings").textContent)[german ? "de" : "en"];
        document.documentElement.lang = german ? "de" : "en";
        document.title = t.title + " | Jeremy Darko";
        document.getElementById("nf-title").textContent = t.title;
        var line = document.getElementById("nf-text");
        line.textContent = t.text + " ";
        var link = document.createElement("a");
        link.id = "nf-back";
        link.href = t.href;
        link.textContent = t.back;
        line.append(link, ".");
        document.getElementById("nf-hint").textContent = t.hint;
        var quest = document.getElementById("nf-quest");
        quest.textContent = t.quest + " · 0/3";
        Object.assign(window, { nfGame: { found: 0, strings: t } });
        document.getElementById("nf-error").textContent = t.error;
        document.getElementById("nf-offline").textContent = t.offline;
        var lost = location.pathname.replace(/\/+$/, "") || "/index";
        document.getElementById("nf-path").firstChild.textContent = "~/jeremy-darko" + lost + ".md ";
        var desktopLinks = document.querySelectorAll(".site-nav > a");
        var mobileLinks = document.querySelectorAll(".mobile-panel > a");
        t.nav.forEach(function (item, index) {
          desktopLinks[index].textContent = item.label;
          desktopLinks[index].href = item.href;
          mobileLinks[index].querySelector("span").textContent = item.label;
          mobileLinks[index].href = item.href;
        });
        document.querySelector(".site-header .brand").href = t.home;
        document.querySelector(".skip-link").textContent = t.skip;
        document.querySelector(".mobile-toggle").setAttribute("aria-label", t.menu);
        document.querySelectorAll(".site-nav, .mobile-panel").forEach(function (nav) {
          nav.setAttribute("aria-label", t.mainNav);
        });
        var mobileSearch = document.querySelector(".mobile-find");
        mobileSearch.setAttribute("aria-label", t.search);
        mobileSearch.title = t.search;
        document.querySelector(".find-btn").firstChild.textContent = t.search + " ";
        var code = german ? "de" : "en";
        document.querySelectorAll(".lang").forEach(function (group) {
          group.setAttribute("data-on", code);
          group.setAttribute("aria-label", t.language);
          group.querySelectorAll("a").forEach(function (a) {
            if (a.getAttribute("lang") === code) a.setAttribute("aria-current", "page");
            else a.removeAttribute("aria-current");
          });
        });
      } catch (error) {}
    })();
  </script>

  <script>
    // A small koi pond for the lost page. Loaded only here; the rest of the site never pays for it.
    const pondSection = document.querySelector<HTMLElement>(".notfound-pond");
    const pondCanvas = document.querySelector<HTMLCanvasElement>(".koi-pond");

    if (pondSection && pondCanvas) {
      void import("../scripts/vendor/ascii-koi.js").then(() => {
        const createPond = (window as unknown as { AsciiKoi?: { createPond: Function } }).AsciiKoi?.createPond;
        if (!createPond) return;

        // Read the theme on every call so the top-bar switch recolours the water too.
        const palette = () =>
          document.documentElement.dataset.theme === "light"
            ? { water: "#d6d9e4", ink: "#1a1b26", accent: "#2552b8", koiLight: "#f7f2e8", koiDark: "#2b2723", dark: false }
            : { water: "#16161e", ink: "#c0caf5", accent: "#7aa2f7", koiLight: "#ece6da", koiDark: "#3a3632", dark: true };

        // Keep the message clear: koi fade only where a line of copy sits and ease back in right
        // after it, so they swim around the words instead of vanishing behind one big panel.
        const dimText = () => {
          const box = pondCanvas.getBoundingClientRect();
          const parts = [
            ...document.querySelectorAll<HTMLElement>(".site-header, #nf-path, .notfound-code, #nf-title, #nf-offline, #nf-text, #nf-quest, .notfound-hint"),
          ];
          const clears = parts
            .map((part) => part.getBoundingClientRect())
            .filter((r) => r.width > 0 && r.height > 0)
            .map((r) => ({
              left: r.left - box.left - 10,
              top: r.top - box.top - 6,
              right: r.right - box.left + 10,
              bottom: r.bottom - box.top + 6,
              min: 0.06,
              fade: 44,
            }));
          return clears.length ? clears : null;
        };

        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const pond = createPond({
          canvas: pondCanvas,
          palette,
          dim: dimText,
          most: 7,
          reduce,
        }) as {
          size: (w: number, h: number) => void;
          start: () => void;
          stop: () => void;
          feed: (x: number, y: number) => void;
          tint: (x: number, y: number) => number[] | null;
        };

        const game = (window as unknown as { nfGame?: { found: number; strings: { quest: string; found: string } } }).nfGame;
        const quest = document.getElementById("nf-quest");
        const foundOne = () => {
          if (!game || !quest || game.found >= 3) return;
          game.found++;
          if (game.found === 3) {
            quest.textContent = game.strings.found;
            document.getElementById("nf-back")?.classList.add("is-found");
          } else {
            quest.textContent = `${game.strings.quest} · ${game.found}/3`;
          }
        };

        const resize = () => pond.size(pondSection.clientWidth, pondSection.clientHeight);
        resize();
        new ResizeObserver(resize).observe(pondSection);
        pond.start();

        // With reduced motion the engine draws one still frame and ignores feeding, so there is
        // no game to describe. Reveal the instructions only when the pond is actually interactive.
        const hintWrap = document.getElementById("nf-hint-wrap");
        if (reduce) {
          quest?.setAttribute("hidden", "");
          hintWrap?.setAttribute("hidden", "");
        } else {
          quest?.removeAttribute("hidden");
          hintWrap?.removeAttribute("hidden");
          const caught: { x: number; y: number }[] = [];
          const reach = [[0, 0], [10, 0], [-10, 0], [0, 10], [0, -10]];
          pondCanvas.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;
            const box = pondCanvas.getBoundingClientRect();
            const x = event.clientX - box.left;
            const y = event.clientY - box.top;
            const onKoi = reach.some(([dx, dy]) => {
              const tint = pond.tint(x + dx, y + dy);
              return tint !== null && (tint[3] ?? 0) > 0.25;
            });
            // One catch per fish: a second click near an earlier catch cannot score again.
            if (onKoi && caught.every((c) => Math.hypot(c.x - x, c.y - y) > 80)) {
              caught.push({ x, y });
              foundOne();
            }
            pond.feed(x, y);
          });
        }
        addEventListener("pagehide", () => pond.stop(), { once: true });
      });
    }
  </script>
</Base>

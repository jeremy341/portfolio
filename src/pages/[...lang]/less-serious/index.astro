---
import Base from "../../../layouts/Base.astro";
import { langOf, langParams } from "../../../lib/i18n";

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const de = lang === "de";
const title = de ? "In Arbeit" : "Work in Progress";
---
<Base lang={lang} title={title} description={de ? "Die spielerische Version des Portfolios ist noch in Arbeit." : "The playful edition of this portfolio is still in progress."} home teaser noindex>
  <div class="teaser-screen">
    <h1 class="teaser-plaque">
      <span class="sr-only">{title}</span>
      <img src={`/less-serious/work-in-progress-${lang}.png`} width={de ? 86 : 126} height="86" alt="" />
    </h1>
  </div>
</Base>

<style>
  :global(html:root:has(body[data-teaser])) {
    --bg: #5d93fd;
    --fg: #182340;
    --muted: #222f52;
    --line: #364d81;
    --accent: #15264c;
    --panel: #f5f5ff;
    --hover: #dbe4fa;
    --search: #294890;
    color-scheme: light;
  }
  :global(body[data-teaser] .vim-status) { display: none; }
  /* Balance the space above and below the plaque without overlaying the header. */
  :global(body[data-teaser]) {
    display: grid;
    grid-template-rows: minmax(max-content, 1fr) auto minmax(0, 1fr);
    min-height: 100dvh;
    padding-bottom: 0;
  }
  :global(body[data-teaser] .site-header) {
    grid-row: 1;
    align-self: start;
  }
  :global(body[data-teaser] main.frame) {
    grid-row: 2;
    padding-bottom: 0;
  }
  .teaser-screen {
    display: grid;
    place-items: center;
    padding-block: 12px;
    text-align: center;
  }
  .teaser-plaque {
    --pin: linear-gradient(#ffe0af, #ffe0af);
    margin: 0;
    padding: 16px 18px 20px;
    border: 2px solid #4f270a;
    background:
      var(--pin) left 5px top 5px / 2px 2px no-repeat,
      var(--pin) right 5px top 5px / 2px 2px no-repeat,
      var(--pin) left 5px bottom 5px / 2px 2px no-repeat,
      var(--pin) right 5px bottom 5px / 2px 2px no-repeat,
      #8a450c;
    box-shadow: inset 2px 2px #da9656, inset -2px -2px #653109, 4px 4px #492a15;
  }
  .teaser-plaque img {
    display: block;
    image-rendering: pixelated;
    width: auto;
    height: 172px;
    filter: brightness(0) invert(1) sepia(1) drop-shadow(2px 2px #4f270a);
  }
  @media (min-width: 640px) and (min-height: 520px) {
    .teaser-plaque { padding: 24px 32px 28px; }
    .teaser-plaque img { height: 258px; filter: brightness(0) invert(1) sepia(1) drop-shadow(3px 3px #4f270a); }
  }
  @media (max-width: 359px) {
    .teaser-plaque { padding-inline: 10px; }
  }
  @media (max-width: 319px), (max-height: 399px) {
    .teaser-plaque img { height: 86px; }
  }
  @media (forced-colors: active) {
    .teaser-plaque { border-color: CanvasText; }
    .teaser-plaque img { display: none; }
    .teaser-plaque .sr-only {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      clip: auto;
      clip-path: none;
      white-space: normal;
    }
  }
</style>
